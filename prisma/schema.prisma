// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  password               String
  firstName              String
  lastName               String
  gender                 String?   // male, female, etc.
  collegeStatus          String?   // studying, alumni
  collegeId              String
  clusterId              String?
  isVerified             Boolean   @default(false)
  hasCompletedOnboarding Boolean   @default(false)
  isActive               Boolean   @default(true)
  homepageUnlockAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  // Profile & Preferences stored as JSON for flexibility
  profile                String?   @db.NVarChar(Max) // serialized JSON with photos
  preferences            String?   @db.NVarChar(Max) // serialized JSON
  
  // Relations
  college                College   @relation(fields: [collegeId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  cluster                Cluster?  @relation(fields: [clusterId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  // Social Interactions (Many-to-Many via Join Tables)
  sentMessages           Message[] @relation("SentMessages")
  receivedMessages       Message[] @relation("ReceivedMessages")
  
  likesSent              Like[]    @relation("LikesSent")
  likesReceived          Like[]    @relation("LikesReceived")
  
  matches                Match[]   @relation("UserMatches")
  matchedBy              Match[]   @relation("MatchedUser")
  
  passedUsers            Passed[]  @relation("UsersPassed")
  passedByUsers          Passed[]  @relation("PassedByUsers")

  tweets                 Tweet[]
  replies                Reply[]
}

model College {
  id          String   @id @default(uuid())
  name        String
  emailDomain String?
  category    String?  // engineering, medical
  genderType  String   @default("coed") // coed, girls, boys
  city        String?
  state       String?
  clusterId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  cluster     Cluster? @relation(fields: [clusterId], references: [id])
}

model Cluster {
  id        String    @id @default(uuid())
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  colleges  College[]
  users     User[]
}

model Message {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  text      String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from      User     @relation("SentMessages", fields: [fromId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  to        User     @relation("ReceivedMessages", fields: [toId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  fromUser   User     @relation("LikesSent", fields: [fromUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([fromUserId, toUserId])
}

model Match {
  id        String   @id @default(uuid())
  userId    String
  matchedId String
  createdAt DateTime @default(now())

  user      User     @relation("UserMatches", fields: [userId], references: [id])
  matchedUser User     @relation("MatchedUser", fields: [matchedId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, matchedId])
}

model Passed {
  id         String   @id @default(uuid())
  userId     String
  passedId   String
  createdAt  DateTime @default(now())

  user       User     @relation("UsersPassed", fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  passedUser User     @relation("PassedByUsers", fields: [passedId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, passedId])
}

model Tweet {
  id        String   @id @default(uuid())
  userId    String
  text      String   @db.NVarChar(280)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  replies   Reply[]
  likes     TweetLike[]
}

model TweetLike {
  id      String @id @default(uuid())
  tweetId String
  userId  String

  tweet   Tweet  @relation(fields: [tweetId], references: [id])
  
  @@unique([tweetId, userId])
}

model Reply {
  id        String   @id @default(uuid())
  tweetId   String
  userId    String
  text      String   @db.NVarChar(280)
  createdAt DateTime @default(now())

  tweet     Tweet    @relation(fields: [tweetId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  user      User     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}
